# cp .env.example .env   (.env is git-ignored)

# /transcribe - key from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# /tag-visuals - key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Vision model; any OpenAI model with image input works.
# OPENAI_VISION_MODEL=gpt-6-luna
# Reasoning effort for tagging (none is cheapest); "unset" sends no reasoning setting.
# OPENAI_REASONING_EFFORT=none
