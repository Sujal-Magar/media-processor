# cp .env.example .env   (.env is git-ignored)

# /transcribe - key from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# /tag-visuals, /tag-topics and /generate-copy - key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Vision model; any OpenAI model with image input works.
# OPENAI_VISION_MODEL=gpt-6-luna
# Reasoning effort for tagging (none is cheapest); "unset" sends no reasoning setting.
# OPENAI_REASONING_EFFORT=none
# Model for /tag-topics (text only); default: the vision model above.
# OPENAI_TOPIC_MODEL=gpt-6-luna
# Reasoning effort for topics (default low); "unset" sends no reasoning setting.
# OPENAI_TOPIC_REASONING_EFFORT=low
# Model for /generate-copy (text only); default: the vision model above.
# OPENAI_COPY_MODEL=gpt-6-luna
# Reasoning effort for copy (default low); "unset" sends no reasoning setting.
# OPENAI_COPY_REASONING_EFFORT=low
